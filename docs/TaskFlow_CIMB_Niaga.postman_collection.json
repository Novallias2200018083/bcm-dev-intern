						"exec": [
							"pm.test(\"Status code adalah 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response time di bawah 200 ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(200);",
							"});",
							"",
							"pm.test(\"Sistem berstatus healthy\", function () {",
							"    const data = pm.response.json();",
							"    pm.expect(data.status).to.eql(\"healthy\");",
							"    pm.expect(data.database).to.eql(\"connected\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
