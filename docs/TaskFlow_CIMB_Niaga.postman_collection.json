		{
			"name": "3. Create New Task (POST)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code adalah 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Payload tugas baru valid & simpan taskId ke Environment\", function () {",
							"    const res = pm.response.json();",
							"    pm.expect(res).to.have.property(\"id\");",
							"    pm.expect(res.title).to.eql(\"Pengujian Otomatis via Postman QA\");",
							"    pm.expect(res.status).to.eql(\"pending\");",
							"    pm.expect(res.priority).to.eql(\"high\");",
							"    ",
							"    // Request Chaining: Simpan ID untuk request selanjutnya",
							"    pm.environment.set(\"currentTaskId\", res.id);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Pengujian Otomatis via Postman QA\",\n    \"description\": \"Validasi response payload, header, dan schema menggunakan Postman Test Runner.\",\n    \"category\": \"Proyek\",\n    \"priority\": \"high\",\n    \"status\": \"pending\",\n    \"due_date\": \"2026-11-08T18:00:00\"\n}"
				},
