					],
					"path": [
						"api",
						"health"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Get Task Statistics (KPI Metrik)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code adalah 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response time di bawah 300 ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(300);",
							"});",
							"",
							"pm.test(\"Header Content-Type adalah application/json\", function () {",
							"    pm.response.to.have.header(\"Content-Type\");",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
							"});",
							"",
							"pm.test(\"Skema Metrik Tugas valid\", function () {",
							"    const res = pm.response.json();",
							"    pm.expect(res).to.have.property(\"total\");",
							"    pm.expect(res).to.have.property(\"completed_on_time\");",
							"    pm.expect(res).to.have.property(\"completed_late\");",
							"    pm.expect(res).to.have.property(\"completion_rate\");",
							"    pm.expect(res.total).to.be.at.least(0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/tasks/stats",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"tasks",
						"stats"
					]
				}
			},
			"response": []
